{
  "name": "Light Modern Warm",
  "type": "light",
  "colors": {
    "foreground": "#3b3b3b",
    "focusBorder": "#005fb8",
    "editor.background": "#fffdf5",
    "editor.foreground": "#3b3b3b",
    "editor.selectionBackground": "#add6ff",
    "editor.lineHighlightBackground": "#fbf6e4",
    "editorCursor.foreground": "#000000",
    "editorLineNumber.foreground": "#8f8a78",
    "editorWhitespace.foreground": "#dcd3b4",
    "editorWidget.background": "#f6efd6",
    "editorGroup.border": "#e6dcb9",
    "editorGroupHeader.tabsBackground": "#f6efd6",
    "sideBar.background": "#f6efd6",
    "sideBar.border": "#e6dcb9",
    "panel.border": "#e6dcb9",
    "dropdown.background": "#f6efd6",
    "menu.background": "#f6efd6",
    "list.hoverBackground": "#eee5c4",
    "list.activeSelectionBackground": "#e3d8ae",
    "list.inactiveSelectionBackground": "#ebe2c0",
    "descriptionForeground": "#6b6656",
    "button.background": "#005fb8",
    "button.foreground": "#ffffff",
    "textLink.foreground": "#005fb8",
    "progressBar.background": "#005fb8",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#e0304e",
    "terminal.ansiGreen": "#1a9a1a",
    "terminal.ansiYellow": "#b07f00",
    "terminal.ansiBlue": "#0a6ed1",
    "terminal.ansiMagenta": "#d0169a",
    "terminal.ansiCyan": "#068aa8",
    "terminal.ansiWhite": "#555555",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBrightRed": "#c4203c",
    "terminal.ansiBrightGreen": "#128012",
    "terminal.ansiBrightYellow": "#8f6700",
    "terminal.ansiBrightBlue": "#0858aa",
    "terminal.ansiBrightMagenta": "#a8107c",
    "terminal.ansiBrightCyan": "#05708a",
    "terminal.ansiBrightWhite": "#a5a5a5"
  },
  "tokenColors": [
    {
      "settings": { "foreground": "#3b3b3b", "background": "#fffdf5" }
    },
    {
      "scope": "comment",
      "settings": { "foreground": "#008000" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#a31515" }
    },
    {
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": { "foreground": "#811f3f" }
    },
    {
      "scope": "constant.numeric",
      "settings": { "foreground": "#098658" }
    },
    {
      "scope": ["constant.language", "support.constant"],
      "settings": { "foreground": "#0000ff" }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "#0000ff" }
    },
    {
      "scope": "keyword.control",
      "settings": { "foreground": "#af00db" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#795e26" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#267f99" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#001080" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#800000" }
    }
  ]
}
