{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mangouste",
  "version": "0.1.5",
  "identifier": "dev.valferon.mangouste",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "mangouste",
        "width": 1600,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "valferon",
    "copyright": "Copyright \u00a9 2026 valferon",
    "category": "DeveloperTool",
    "shortDescription": "Single-window multi-repo Claude Code workbench",
    "longDescription": "A desktop workbench for Claude Code: every session on the machine in one window, with a file tree, git history, an integrated terminal, and a chat pane driven by the claude CLI over stream-json. Replaces running one editor window per repository.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64 | libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
